# API portu
PORT=3001
# MariaDB (docker compose değerleriyle aynı)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iprint
DB_PASSWORD=iprint_dev_password
DB_NAME=iprint
# En az 32 rastgele karakter üretin: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
# Billing webhook imza anahtarı: openssl rand -hex 32
WEBHOOK_SECRET=
# Trendyol pazaryeri entegrasyonu (SPEC-03) — gerçek anahtarlar ASLA repoya girmez
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# Test/staging gateway'i buradan değiştirin
TRENDYOL_REQUIRE_AUTH=false
TRENDYOL_BASE_URL=https://apigw.trendyol.com
# true → gerçek API yerine deterministik 12 paketlik demo veri döner
TRENDYOL_MOCK=false

# İstemci Geliştirici Hızlı Giriş bu değerlerle eşleşir
DEV_TEST_EMAIL=dev@iprint.local
DEV_TEST_PASSWORD=iprint-dev-2026
TRENDYOL_REQUIRE_AUTH=false
